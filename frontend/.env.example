# Motorcart frontend — copy to .env.local
# Dev without Docker: Vite proxies /api to this target (not used as axios baseURL)
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3001

# Leave empty for same-origin /api (recommended for dev + Docker via nginx)
VITE_API_URL=
VITE_SOCKET_URL=
VITE_SITE_URL=http://localhost:3000

# Phase J Growth CRM (default OFF — UI hidden until VITE_FEATURE_GROWTH_V2=true)
# VITE_FEATURE_GROWTH_V2=false
# VITE_FEATURE_GROWTH_WORKSPACES=false
# VITE_FEATURE_GROWTH_ASSETS=false
# VITE_FEATURE_GROWTH_POSTERS=false
# VITE_FEATURE_GROWTH_WHATSAPP=false
# VITE_FEATURE_GROWTH_LEADS=false
# VITE_FEATURE_GROWTH_LEAD_PIPELINE=false

# Phase K2 business directory (default OFF)
# VITE_FEATURE_BUSINESS_DIRECTORY_V2=false

# Phase K1 directory monetization (requires VITE_FEATURE_BUSINESS_DIRECTORY_V2)
# VITE_FEATURE_K1_DIRECTORY_MONETIZATION=false

# Phase L1 WhatsApp provider architecture (requires VITE_FEATURE_GROWTH_WHATSAPP)
# VITE_FEATURE_GROWTH_WHATSAPP_PROVIDERS=false

# Phase L2 social scheduler (requires VITE_FEATURE_GROWTH_WORKSPACES)
# VITE_FEATURE_GROWTH_SOCIAL_SCHEDULER=false

# Phase M0 founder dashboard
# VITE_FEATURE_M0_FOUNDER_DASHBOARD=false

# Phase M1.0 unified identity
# VITE_FEATURE_M1_UNIFIED_IDENTITY=false

# Phase M2.0 business hub
# VITE_FEATURE_M2_UNIFIED_BUSINESS=false

# Phase M3.0 unified lead router
# VITE_FEATURE_M3_LEAD_ROUTER=false

# Phase M4.0 unified notifications
# VITE_FEATURE_M4_NOTIFICATIONS=false

# Phase M5.0 unified search
# VITE_FEATURE_M5_UNIFIED_SEARCH=false

# Phase N2.1 billing MVP (default OFF)
# VITE_FEATURE_BILLING_V2=false

# Phase 5B catalog import admin (requires backend FEATURE_CATALOG_ADMIN=true)
# VITE_FEATURE_CATALOG_ADMIN=false
