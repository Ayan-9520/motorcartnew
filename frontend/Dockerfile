# syntax=docker/dockerfile:1

FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=
ARG VITE_SOCKET_URL=
ARG VITE_SITE_URL=
ARG VITE_FULL_ECOSYSTEM=true
ARG VITE_FEATURE_WISHLIST_DB=true
ARG VITE_FEATURE_UNIFIED_VEHICLE_API=true
ARG VITE_FEATURE_M4_NOTIFICATIONS=true
ARG VITE_REAL_DATA_ONLY=true
ARG VITE_ADMIN_DEMO_FALLBACK=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL
ENV VITE_SITE_URL=$VITE_SITE_URL
ENV VITE_FULL_ECOSYSTEM=$VITE_FULL_ECOSYSTEM
ENV VITE_FEATURE_WISHLIST_DB=$VITE_FEATURE_WISHLIST_DB
ENV VITE_FEATURE_UNIFIED_VEHICLE_API=$VITE_FEATURE_UNIFIED_VEHICLE_API
ENV VITE_FEATURE_M4_NOTIFICATIONS=$VITE_FEATURE_M4_NOTIFICATIONS
ENV VITE_REAL_DATA_ONLY=$VITE_REAL_DATA_ONLY
ENV VITE_ADMIN_DEMO_FALLBACK=$VITE_ADMIN_DEMO_FALLBACK

RUN npm run build

FROM nginx:1.27-alpine AS runner
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
CMD ["nginx", "-g", "daemon off;"]
