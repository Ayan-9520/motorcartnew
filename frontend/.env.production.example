# Copy to .env.production before: npm run build
# Use your LIVE API URL (HTTPS in production)

VITE_API_URL=https://api.yourdomain.com
VITE_SOCKET_URL=https://api.yourdomain.com
VITE_SITE_URL=https://yourdomain.com

# Optional: app hosted in subfolder e.g. https://domain.com/motorcart/
# VITE_BASE_PATH=/motorcart/

# Phase C finance marketplace REST (set false to keep RPC/mock until QA)
# VITE_FEATURE_FINANCE_MARKETPLACE=true
# VITE_FEATURE_FINANCE_ELIGIBILITY_API=true
# VITE_FEATURE_FINANCE_COMPARE_API=true
# VITE_FEATURE_FINANCE_SOFT_APPROVAL=true
# VITE_FEATURE_FINANCE_DOCUMENTS_API=true

# Phase B (default on when unset)
# VITE_FEATURE_VEHICLE_SALE_MODE=true
# VITE_FEATURE_NEW_CAR_INVENTORY_V2=true
# VITE_FEATURE_WISHLIST_DB=true
# VITE_FEATURE_UNIFIED_VEHICLE_API=true
# VITE_FEATURE_PARTS_COMPATIBILITY=true
