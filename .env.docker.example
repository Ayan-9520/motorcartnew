# Docker Compose environment — copy to .env.docker at repo root (local dev)
NODE_ENV=development

POSTGRES_DB=motorcart
POSTGRES_USER=motorcart
POSTGRES_PASSWORD=strongpassword
POSTGRES_PORT=5432

REDIS_PORT=6379

PORT=3001
DATABASE_URL=postgresql://motorcart:strongpassword@postgres:5432/motorcart?schema=public
JWT_SECRET=change-me-jwt-secret-min-32-characters-long
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
REDIS_URL=redis://redis:6379
OPENAI_API_KEY=

CORS_ORIGIN=http://localhost:3000,http://localhost:8090,http://127.0.0.1:8090
FRONTEND_URL=http://localhost:3000
NGINX_PORT=3000

VITE_API_URL=
VITE_SOCKET_URL=
VITE_SITE_URL=http://localhost:3000

VITE_FULL_ECOSYSTEM=true
FEATURE_FULL_ECOSYSTEM=true
FEATURE_WISHLIST_DB=true
VITE_FEATURE_WISHLIST_DB=true
FEATURE_UNIFIED_VEHICLE_API=true
VITE_FEATURE_UNIFIED_VEHICLE_API=true
FEATURE_M4_NOTIFICATIONS=true
VITE_FEATURE_M4_NOTIFICATIONS=true

# Real data only — no mock catalog on public site (set false for demo/dev showcase)
VITE_REAL_DATA_ONLY=true
VITE_ADMIN_DEMO_FALLBACK=false

STRICT_DB_QUERY=false

# Phase Catalog 1 — master catalog layer (default OFF)
FEATURE_CATALOG_LAYER=false
FEATURE_CATALOG_PUBLIC_API=false
FEATURE_CATALOG_ADMIN=false

# Catalog master JSON API — LOCAL mock only (tools/catalog-master-mock-api). Not a real provider.
CATALOG_MASTER_SOURCE=json_api
CATALOG_MASTER_SOURCE_URL=http://catalog-master-mock:3099/v1/vehicles
CATALOG_MASTER_API_KEY=local-dev-mock-key
CATALOG_MASTER_MOCK_PORT=3099

MOBILE_APP_PORT=8090
MOBILE_EXPO_PUBLIC_API_URL=
MOBILE_SHOW_DEMO=1
