# Docker Compose environment — copy to .env.docker at repo root
NODE_ENV=development

POSTGRES_DB=motorcart
POSTGRES_USER=motorcart
POSTGRES_PASSWORD=strongpassword
POSTGRES_PORT=5432

REDIS_PORT=6379

PORT=3001
DATABASE_URL=postgresql://motorcart:strongpassword@postgres:5432/motorcart?schema=public
JWT_SECRET=change-me-jwt-secret-min-32-characters-long
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
REDIS_URL=redis://redis:6379
OPENAI_API_KEY=

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NGINX_PORT=3000

# Browser-facing URLs (empty = same-origin via nginx /api proxy)
VITE_API_URL=
VITE_SOCKET_URL=
VITE_SITE_URL=http://localhost:3000
