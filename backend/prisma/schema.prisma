// Motorcart.in — PostgreSQL schema (Prisma migrations)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  customer
  dealer
  used_car_dealer
  preowned_dealer
  new_car_dealer
  bike_dealer
  truck_dealer
  dsa_agent
  bank_nbfc
  finance_manager
  service_center
  service_partner
  service_technician
  parts_seller
  admin
  super_admin
  auction_partner
  employee
  finance_partner
  broker
}

enum UserStatus {
  active
  suspended
  pending_verification
  closed
}

enum KycStatus {
  pending
  submitted
  verified
  rejected
}

enum VehicleStatus {
  draft
  available
  reserved
  sold
}

enum VehicleSaleMode {
  direct_owner
  broker_assisted
  dealer_offer
  auction_sale
}

enum AuctionStatus {
  upcoming
  live
  ended
  cancelled
}

enum AuctionCategory {
  bank
  insurance
  fleet
  dealer
  government
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

enum FinanceStatus {
  draft
  submitted
  processing
  approved
  rejected
  disbursed
}

enum BookingStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
}

enum CommunityPersona {
  customer
  dealer
  broker
  dsa
  insurance_agent
  workshop
  parts_seller
  influencer
}

enum CommunityBusinessEntityType {
  dealer
  broker
  dsa
  insurance_agent
  workshop
  parts_seller
  influencer
}

enum CommunityMemberRole {
  member
  moderator
  admin
  group_owner
  group_moderator
}

enum SocialPostKind {
  discussion
  review
  poll
  embed
}

enum SocialModerationStatus {
  pending
  approved
  rejected
  hidden
}

model User {
  id                String     @id @default(uuid())
  email             String?    @unique
  phone             String?    @unique
  passwordHash      String?    @map("password_hash")
  fullName          String     @default("") @map("full_name")
  avatarUrl         String?    @map("avatar_url")
  role              AppRole    @default(customer)
  status            UserStatus @default(active)
  kycStatus         KycStatus  @default(pending) @map("kyc_status")
  kycData           Json       @default("{}") @map("kyc_data")
  companyName       String?    @map("company_name")
  city              String?
  state             String?
  isVerified        Boolean    @default(false) @map("is_verified")
  emailVerified     Boolean    @default(false) @map("email_verified")
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  metadata          Json       @default("{}")
  onboardingStatus  String?    @map("onboarding_status")
  approvalStatus    String?    @map("approval_status")
  profileCompletion Int        @default(0) @map("profile_completion")
  communityHandle   String?    @unique @map("community_handle") @db.VarChar(32)
  communityBio      String?    @map("community_bio") @db.Text
  communityCoverUrl String?    @map("community_cover_url") @db.VarChar(512)
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  dealers           Dealer[]
  vehicles          Vehicle[]  @relation("SellerVehicles")
  refreshTokens     RefreshToken[]
  activityLogs      ActivityLog[]
  deviceSessions    DeviceSession[]
  wishlists         Wishlist[]
  financeApps       FinanceApplication[]
  insuranceApps     InsuranceApplication[]
  serviceBookings   ServiceBooking[]
  bookings          Booking[]
  auctionBids       AuctionBid[]
  notifications     Notification[]
  communityPosts    CommunityPost[]
  customerVehicles  CustomerVehicle[]
  ownedBrokers      Broker[]
  communityProfile  CommunityUserProfile?
  communityBusinessProfiles CommunityBusinessProfile[]
  communityFollows  CommunityFollow[]          @relation("CommunityFollower")
  communityGroupMembers CommunityGroupMember[]
  communityRoleAssignments CommunityRoleAssignment[]
  socialPosts       SocialPost[]
  postLikes         PostLike[]
  postComments      PostComment[]
  postShares        PostShare[]
  pollVotes         PollVote[]
  growthWorkspacesOwned GrowthWorkspace[] @relation("GrowthWorkspaceOwner")
  organizationMemberships OrganizationMember[]

  @@index([role])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_codes")
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_resets")
}

model Dealer {
  id                   String    @id @default(uuid())
  ownerId              String    @map("owner_id")
  name                 String
  slug                 String    @unique
  logoUrl              String?   @map("logo_url")
  description          String?   @db.Text
  dealerType           AppRole   @default(dealer) @map("dealer_type")
  rating               Decimal   @default(0) @db.Decimal(3, 2)
  reviewCount          Int       @default(0) @map("review_count")
  address              String?   @db.Text
  city                 String
  state                String
  pincode              String?
  phone                String?
  email                String?
  website              String?
  gstNumber            String?   @map("gst_number")
  panNumber            String?   @map("pan_number")
  isVerified           Boolean   @default(false) @map("is_verified")
  specialties          Json      @default("[]")
  subscriptionTier     String    @default("basic") @map("subscription_tier")
  totalListingsCap     Int       @default(25) @map("total_listings_cap")
  verificationStatus   String?   @map("verification_status")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  owner                User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vehicles             Vehicle[]
  leads                Lead[]
  members              DealerMember[]
  storefront           DealerStorefront?
  documents            DealerDocument[]
  auctionEntries       DealerAuctionEntry[]
  leadCalls            LeadCall[]
  linkedOrganization   Organization?

  @@index([ownerId])
  @@index([city])
  @@map("dealers")
}

model LeadCall {
  id              String   @id @default(uuid())
  leadId          String   @map("lead_id")
  dealerId        String   @map("dealer_id")
  calledBy        String?  @map("called_by")
  direction       String   @default("outbound")
  durationSeconds Int?     @map("duration_seconds")
  outcome         String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  dealer          Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([dealerId])
  @@map("lead_calls")
}

model DealerMember {
  id          String    @id @default(uuid())
  dealerId    String    @map("dealer_id")
  userId      String?   @map("user_id")
  email       String
  fullName    String    @map("full_name")
  phone       String?
  role        String    @default("sales")
  permissions Json      @default("{}")
  isActive    Boolean   @default(true) @map("is_active")
  invitedAt   DateTime  @default(now()) @map("invited_at")
  joinedAt    DateTime? @map("joined_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  dealer      Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([dealerId, email])
  @@index([dealerId])
  @@map("dealer_members")
}

model DealerStorefront {
  dealerId          String   @id @map("dealer_id")
  seoTitle          String?  @map("seo_title")
  seoDescription    String?  @map("seo_description") @db.Text
  coverUrl          String?  @map("cover_url")
  heroTagline       String?  @map("hero_tagline")
  showcaseTags      Json     @default("[]") @map("showcase_tags")
  showFinanceOffers Boolean  @default(true) @map("show_finance_offers")
  showReviews       Boolean  @default(true) @map("show_reviews")
  showInventory     Boolean  @default(true) @map("show_inventory")
  contactWhatsapp   String?  @map("contact_whatsapp")
  contactPhone      String?  @map("contact_phone")
  businessHours     Json     @default("{}") @map("business_hours")
  updatedAt         DateTime @updatedAt @map("updated_at")

  dealer            Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@map("dealer_storefronts")
}

model DealerDocument {
  id              String    @id @default(uuid())
  dealerId        String    @map("dealer_id")
  docType         String    @map("doc_type")
  fileUrl         String    @map("file_url")
  fileName        String?   @map("file_name")
  status          String    @default("pending")
  reviewedBy      String?   @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  rejectionReason String?   @map("rejection_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  dealer          Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@map("dealer_documents")
}

model DealerAuctionEntry {
  id        String   @id @default(uuid())
  dealerId  String   @map("dealer_id")
  auctionId String   @map("auction_id")
  status    String   @default("registered")
  maxBid    BigInt?  @map("max_bid")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([dealerId, auctionId])
  @@index([dealerId])
  @@map("dealer_auction_entries")
}

model CrmTask {
  id          String    @id @default(uuid())
  dealerId    String    @map("dealer_id")
  leadId      String?   @map("lead_id")
  assignedTo  String?   @map("assigned_to")
  title       String
  description String?   @db.Text
  dueAt       DateTime? @map("due_at")
  status      String    @default("pending")
  priority    String    @default("normal")
  taskType    String    @default("callback") @map("task_type")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([dealerId])
  @@map("crm_tasks")
}

model DealerLeadNote {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  dealerId  String   @map("dealer_id")
  authorId  String?  @map("author_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@map("dealer_lead_notes")
}

// --- Phase E: Broker CRM (isolated from dealer leads / crm_tasks) ---

model Broker {
  id                    String   @id @default(uuid())
  ownerId               String   @map("owner_id")
  name                  String   @db.VarChar(128)
  slug                  String   @unique @db.VarChar(64)
  licenseNumber         String?  @map("license_number") @db.VarChar(64)
  city                  String   @db.VarChar(64)
  state                 String   @db.VarChar(64)
  phone                 String?  @db.VarChar(20)
  whatsappNumber        String?  @map("whatsapp_number") @db.VarChar(20)
  email                 String?  @db.VarChar(128)
  commissionDefaultRate Decimal  @default(2.00) @map("commission_default_rate") @db.Decimal(5, 2)
  isVerified            Boolean  @default(false) @map("is_verified")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  owner                 User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  buyers                BrokerBuyer[]
  sellers               BrokerSeller[]
  leads                 BrokerLead[]
  deals                 BrokerDeal[]
  tasks                 BrokerTask[]
  commissions           BrokerCommission[]
  leadNotes             BrokerLeadNote[]
  whatsappConfig        BrokerWhatsAppConfig?
  whatsappTemplates     BrokerWhatsAppTemplate[]
  whatsappMessages      BrokerWhatsAppMessage[]

  @@index([ownerId])
  @@map("brokers")
}

model BrokerBuyer {
  id              String   @id @default(uuid())
  brokerId        String   @map("broker_id")
  fullName        String   @map("full_name") @db.VarChar(128)
  phone           String   @db.VarChar(20)
  email           String?  @db.VarChar(128)
  city            String?  @db.VarChar(64)
  budgetMin       BigInt?  @map("budget_min")
  budgetMax       BigInt?  @map("budget_max")
  preferredBrands Json     @default("[]") @map("preferred_brands")
  preferredFuel   String?  @map("preferred_fuel") @db.VarChar(32)
  notes           String?  @db.Text
  status          String   @default("active") @db.VarChar(24)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  broker          Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  leads           BrokerLead[]
  deals           BrokerDeal[]

  @@index([brokerId, phone])
  @@index([brokerId, status])
  @@map("broker_buyers")
}

model BrokerSeller {
  id        String   @id @default(uuid())
  brokerId  String   @map("broker_id")
  fullName  String   @map("full_name") @db.VarChar(128)
  phone     String   @db.VarChar(20)
  email     String?  @db.VarChar(128)
  city      String?  @db.VarChar(64)
  sellerType String  @default("individual") @map("seller_type") @db.VarChar(24)
  kycStatus String   @default("pending") @map("kyc_status") @db.VarChar(24)
  notes     String?  @db.Text
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  broker    Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  leads     BrokerLead[]
  deals     BrokerDeal[]

  @@index([brokerId, phone])
  @@map("broker_sellers")
}

model BrokerLead {
  id              String   @id @default(uuid())
  brokerId        String   @map("broker_id")
  buyerId         String?  @map("buyer_id")
  sellerId        String?  @map("seller_id")
  name            String   @db.VarChar(128)
  phone           String   @db.VarChar(20)
  email           String?  @db.VarChar(128)
  source          String   @default("manual") @db.VarChar(32)
  status          String   @default("new") @db.VarChar(24)
  vehicleInterest String?  @map("vehicle_interest") @db.VarChar(255)
  vehicleId       String?  @map("vehicle_id")
  vehicleSlug     String?  @map("vehicle_slug") @db.VarChar(128)
  saleMode        String?  @map("sale_mode") @db.VarChar(32)
  assignedTo      String?  @map("assigned_to")
  notes           String?  @db.Text
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  broker          Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  buyer           BrokerBuyer? @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  seller          BrokerSeller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  deals            BrokerDeal[]
  tasks            BrokerTask[]
  leadNotes        BrokerLeadNote[]
  whatsappMessages BrokerWhatsAppMessage[]

  @@index([brokerId, status])
  @@index([brokerId, createdAt])
  @@map("broker_leads")
}

model BrokerDeal {
  id               String    @id @default(uuid())
  brokerId         String    @map("broker_id")
  leadId           String?   @map("lead_id")
  buyerId          String?   @map("buyer_id")
  sellerId         String?   @map("seller_id")
  title            String    @db.VarChar(255)
  stage            String    @default("inquiry") @db.VarChar(32)
  dealValue        BigInt?   @map("deal_value")
  tokenAmount      BigInt?   @map("token_amount")
  expectedCloseAt  DateTime? @map("expected_close_at") @db.Date
  closedAt         DateTime? @map("closed_at")
  lostReason       String?   @map("lost_reason") @db.VarChar(255)
  commissionRate   Decimal?  @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount BigInt?   @map("commission_amount")
  assignedTo       String?   @map("assigned_to")
  notes            String?   @db.Text
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  broker           Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead             BrokerLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  buyer            BrokerBuyer? @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  seller           BrokerSeller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  vehicles         BrokerDealVehicle[]
  stageHistory     BrokerDealStageHistory[]
  commission       BrokerCommission?
  tasks            BrokerTask[]
  whatsappMessages BrokerWhatsAppMessage[]

  @@index([brokerId, stage])
  @@index([brokerId, closedAt])
  @@map("broker_deals")
}

model BrokerDealVehicle {
  id           String   @id @default(uuid())
  dealId       String   @map("deal_id")
  vehicleId    String?  @map("vehicle_id")
  vehicleSlug  String?  @map("vehicle_slug") @db.VarChar(128)
  isPrimary    Boolean  @default(false) @map("is_primary")
  listingTitle String?  @map("listing_title") @db.VarChar(255)
  listingPrice BigInt?  @map("listing_price")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  deal         BrokerDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([vehicleId])
  @@map("broker_deal_vehicles")
}

model BrokerDealStageHistory {
  id         String   @id @default(uuid())
  dealId     String   @map("deal_id")
  fromStage  String?  @map("from_stage") @db.VarChar(32)
  toStage    String   @map("to_stage") @db.VarChar(32)
  changedBy  String?  @map("changed_by")
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  deal       BrokerDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("broker_deal_stage_history")
}

model BrokerTask {
  id          String    @id @default(uuid())
  brokerId    String    @map("broker_id")
  leadId      String?   @map("lead_id")
  dealId      String?   @map("deal_id")
  assignedTo  String?   @map("assigned_to")
  taskType    String    @default("callback") @map("task_type") @db.VarChar(32)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  dueAt       DateTime? @map("due_at")
  status      String    @default("pending") @db.VarChar(24)
  priority    String    @default("normal") @db.VarChar(16)
  completedAt DateTime? @map("completed_at")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  broker      Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead        BrokerLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal        BrokerDeal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([brokerId, dueAt])
  @@index([brokerId, status])
  @@map("broker_tasks")
}

model BrokerCommission {
  id               String    @id @default(uuid())
  brokerId         String    @map("broker_id")
  dealId           String    @unique @map("deal_id")
  dealValue        BigInt    @map("deal_value")
  commissionRate   Decimal   @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount BigInt    @map("commission_amount")
  status           String    @default("pending") @db.VarChar(24)
  paidAt           DateTime? @map("paid_at")
  payoutReference  String?   @map("payout_reference") @db.VarChar(64)
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")

  broker           Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  deal             BrokerDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([brokerId, status])
  @@map("broker_commissions")
}

model BrokerLeadNote {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  brokerId  String   @map("broker_id")
  authorId  String?  @map("author_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  lead      BrokerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  broker    Broker     @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("broker_lead_notes")
}

model BrokerWhatsAppConfig {
  id            String   @id @default(uuid())
  brokerId      String   @unique @map("broker_id")
  provider      String   @default("manual") @db.VarChar(32)
  businessPhone String   @map("business_phone") @db.VarChar(20)
  webhookSecret String?  @map("webhook_secret") @db.VarChar(128)
  apiConfig     Json     @default("{}") @map("api_config")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  broker        Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@map("broker_whatsapp_configs")
}

model BrokerWhatsAppTemplate {
  id                 String   @id @default(uuid())
  brokerId           String   @map("broker_id")
  templateKey        String   @map("template_key") @db.VarChar(64)
  name               String   @db.VarChar(128)
  body               String   @db.Text
  language           String   @default("en") @db.VarChar(8)
  providerTemplateId String?  @map("provider_template_id") @db.VarChar(64)
  status             String   @default("draft") @db.VarChar(24)
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at")

  broker             Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId])
  @@map("broker_whatsapp_templates")
}

model BrokerWhatsAppMessage {
  id                String   @id @default(uuid())
  brokerId          String   @map("broker_id")
  leadId            String?  @map("lead_id")
  dealId            String?  @map("deal_id")
  direction         String   @db.VarChar(8)
  providerMessageId String?  @unique @map("provider_message_id") @db.VarChar(128)
  phone             String   @db.VarChar(20)
  body              String   @db.Text
  status            String   @default("queued") @db.VarChar(24)
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")

  broker            Broker     @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead              BrokerLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal              BrokerDeal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([brokerId, createdAt])
  @@index([leadId])
