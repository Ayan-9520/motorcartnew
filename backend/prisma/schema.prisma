// ─── Catalog Layer (Phase 1 — master vehicle catalog, no marketplace FKs yet) ───

enum CatalogSegment {
  car
  bike
  scooter
  ev
  truck
  bus
  pickup
  tractor
  construction_equipment
  farm_equipment
  commercial_vehicle
  auto
  rickshaw
}

enum CatalogConditionScope {
  new
  used
  refurbished
  all
}

enum CatalogPublishStatus {
  draft
  review
  published
  archived
  discontinued
}

enum CatalogDataSourceType {
  manual
  csv
  excel
  json
  api
  scrape
  oem_feed
}

model CatalogCity {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  state     String
  stateSlug String   @map("state_slug")
  tier      Int      @default(3)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cityPrices CatalogVariantCityPrice[]

  @@index([stateSlug])
  @@index([isActive])
  @@map("catalog_cities")
}

model CatalogDataSource {
  id         String                @id @default(uuid())
  code       String                @unique
  name       String
  sourceType CatalogDataSourceType @map("source_type")
  baseUrl    String?               @map("base_url") @db.VarChar(512)
  isActive   Boolean               @default(true) @map("is_active")
  config     Json                  @default("{}")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  variants CatalogVariant[]

  @@index([sourceType, isActive])
  @@map("catalog_data_sources")
}

model CatalogBrand {
  id         String               @id @default(uuid())
  name       String
  slug       String               @unique
  segment    CatalogSegment
  country    String               @default("IN")
  logoUrl    String?              @map("logo_url") @db.VarChar(512)
  websiteUrl String?              @map("website_url") @db.VarChar(512)
  status     CatalogPublishStatus @default(draft)
  metadata   Json                 @default("{}")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  models CatalogModel[]

  @@index([segment, slug])
  @@index([status])
  @@map("catalog_brands")
}

model CatalogModel {
  id              String                @id @default(uuid())
  brandId         String                @map("brand_id")
  name            String
  slug            String
  segment         CatalogSegment
  bodyType        String                @map("body_type")
  conditionScope  CatalogConditionScope @default(all) @map("condition_scope")
  launchYear      Int?                  @map("launch_year")
  discontinueYear Int?                  @map("discontinue_year")
  status          CatalogPublishStatus  @default(draft)
  metadata        Json                  @default("{}")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  brand    CatalogBrand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  variants CatalogVariant[]

  @@unique([brandId, slug])
  @@index([segment, bodyType])
  @@index([status])
  @@map("catalog_models")
}

model CatalogVariant {
  id            String                @id @default(uuid())
  modelId       String                @map("model_id")
  name          String
  slug          String
  businessKey   String                @unique @map("business_key")
  fuelType      String                @map("fuel_type")
  transmission  String
  modelYear     Int                   @map("model_year")
  conditionScope CatalogConditionScope @default(new) @map("condition_scope")
  seating       Int?
  exShowroomRef Decimal?              @map("ex_showroom_ref") @db.Decimal(12, 2)
  status        CatalogPublishStatus  @default(draft)
  sourceId      String?               @map("source_id")
  externalId    String?               @map("external_id")
  sourceUrl     String?               @map("source_url") @db.VarChar(1024)
  publishedAt   DateTime?             @map("published_at")
  metadata      Json                  @default("{}")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  model          CatalogModel            @relation(fields: [modelId], references: [id], onDelete: Cascade)
  source         CatalogDataSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  specifications CatalogVariantSpec?
  media          CatalogVariantMedia[]
  colors         CatalogVariantColor[]
  features       CatalogVariantFeature[]
  cityPrices     CatalogVariantCityPrice[]
  vehicles       Vehicle[]
  ncdInventory   NewCarInventory[]

  @@unique([modelId, slug])
  @@unique([sourceId, externalId])
  @@index([modelId, fuelType, transmission])
  @@index([status])
  @@index([modelYear])
  @@map("catalog_variants")
}

model CatalogVariantSpec {
  id           String @id @default(uuid())
  variantId    String @unique @map("variant_id")
  engine       String?
  displacement String?
  power        String?
  torque       String?
  mileage      String?
  rangeKm      String? @map("range_km")
  seating      Int?
  bootSpace    String? @map("boot_space")
  dimensions   Json    @default("{}")
  safety       Json    @default("[]")
  comfort      Json    @default("[]")
  extras       Json    @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  variant CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("catalog_variant_specs")
}

model CatalogVariantMedia {
  id        String  @id @default(uuid())
  variantId String  @map("variant_id")
  mediaType String  @map("media_type")
  url       String  @db.VarChar(1024)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  altText   String? @map("alt_text")
  sourceId  String? @map("source_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, mediaType, sortOrder])
  @@map("catalog_variant_media")
}

model CatalogVariantColor {
  id        String  @id @default(uuid())
  variantId String  @map("variant_id")
  name      String
  hexCode   String? @map("hex_code")
  imageUrl  String? @map("image_url") @db.VarChar(1024)
  isDefault Boolean @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("catalog_variant_colors")
}

model CatalogVariantFeature {
  id        String   @id @default(uuid())
  variantId String   @map("variant_id")
  category  String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  variant CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, category])
  @@map("catalog_variant_features")
}

model CatalogVariantCityPrice {
  id            String    @id @default(uuid())
  variantId     String    @map("variant_id")
  cityId        String    @map("city_id")
  exShowroom    Decimal   @map("ex_showroom") @db.Decimal(12, 2)
  onRoad        Decimal?  @map("on_road") @db.Decimal(12, 2)
  rto           Decimal?  @db.Decimal(12, 2)
  insurance     Decimal?  @db.Decimal(12, 2)
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  sourceId      String?   @map("source_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  variant CatalogVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  city    CatalogCity    @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([variantId, cityId, effectiveFrom], map: "catalog_variant_city_prices_v_city_eff_key")
  @@index([cityId, variantId])
  @@map("catalog_variant_city_prices")
}

// --- Phase 3: Organization / Partner foundation (additive; existing Dealer/User/Lead unchanged) ---

enum OrganizationType {
  DEALER
  OEM
  MANUFACTURER
  BANK
  NBFC
  INSURANCE_COMPANY
  INSURANCE_BROKER
  WORKSHOP
  SERVICE_CENTER
  PARTS_SELLER
  PARTS_MANUFACTURER
  AUCTION_PARTNER
  FINANCE_DSA
  AUTOMOTIVE_PROFESSIONAL
  FLEET_OPERATOR
  VALUATION_PARTNER
  OTHER
}

enum OrganizationStatus {
  active
  pending
  suspended
  archived
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MANAGER
  SALES
  FINANCE
  INSURANCE
  SERVICE
  PARTS
  OPERATIONS
  CALL_AGENT
  MARKETING
  VIEWER
}

enum OrganizationMemberStatus {
  invited
  active
  suspended
  removed
}

enum PartnerVerificationStatus {
  unverified
  pending
  verified
  rejected
}

model Organization {
  id               String             @id @default(uuid())
  type             OrganizationType
  status           OrganizationStatus @default(active)
  name             String
  displayName      String             @map("display_name")
  slug             String             @unique
  planSlug         String             @default("free") @map("plan_slug") @db.VarChar(32)
  legacyDealerId   String?            @unique @map("legacy_dealer_id")
  typeMetadata     Json               @default("{}") @map("type_metadata")
  createdByUserId  String             @map("created_by_user_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")

  legacyDealer     Dealer?            @relation(fields: [legacyDealerId], references: [id], onDelete: SetNull)
  members          OrganizationMember[]
  branches         OrganizationBranch[]
  profile          PartnerProfile?
  entitlements     OrganizationEntitlement[]
  badges           PartnerBadgeAssignment[]
  quotations       Quotation[]
  testDrives       TestDriveBooking[]
  partnerCoverages PartnerCoverage[]
  opportunities    Opportunity[]
  crmActivities    CrmActivity[]
  subscriptions    OrganizationSubscription[]
  commercialPayments CommercialPayment[]
  invoices         CommercialInvoice[]
  payoutAccount    PartnerPayoutAccount?
  payoutEntries    PartnerPayoutEntry[]
  payoutRequests   PartnerPayoutRequest[]
  promotions       PromotionOrder[]
  payoutRules      CommercialPayoutRule[]
  valuations       VehicleValuation[]
  communicationProviders CommunicationProvider[]
  communicationPolicies CommunicationPolicy[]
  communicationThreads CommunicationThread[]
  callSessions     CallSession[]
  aiConversations  AiConversation[]
  aiUsageRecords   AiUsageRecord[]
  aiAgentConfigs   AiAgentConfig[]
  oemAuthorizations OrganizationDealerAuthorization[] @relation("OemAuthorizations")
  dealerAuthorizations OrganizationDealerAuthorization[] @relation("DealerAuthorizations")
  domainCoverages  OrganizationCoverage[]
  financeProducts  FinanceProduct[]
  insurancePolicies InsurancePolicy[]
  insuranceClaims  InsuranceClaim[]
  jobPostings      JobPosting[]
  partnerCertifications PartnerCertification[]
  partnerRatings   PartnerRating[]
  serviceEstimates ServiceEstimate[]
  serviceSlots     ServiceSlot[]

  @@index([type, status])
  @@index([createdByUserId])
  @@map("organizations")
}

model OrganizationBranch {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  isHeadquarters Boolean  @default(false) @map("is_headquarters")
  address        String?  @db.Text
  city           String?
  state          String?
  country        String   @default("IN")
  postalCode     String?  @map("postal_code") @db.VarChar(16)
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  contactNumber  String?  @map("contact_number")
  businessHours  Json     @default("{}") @map("business_hours")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  testDrives     TestDriveBooking[]

  @@index([organizationId])
  @@index([country, postalCode])
  @@map("organization_branches")
}

model OrganizationMember {
  id             String                   @id @default(uuid())
  organizationId String                   @map("organization_id")
  userId         String                   @map("user_id")
  role           OrganizationMemberRole   @default(VIEWER)
  status         OrganizationMemberStatus @default(active)
  branchId       String?                  @map("branch_id")
  department     String?
  permissions    Json                     @default("[]")
  joinedAt       DateTime                 @default(now()) @map("joined_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch         OrganizationBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_members")
}

model PartnerProfile {
  id                 String                    @id @default(uuid())
  organizationId     String                    @unique @map("organization_id")
  businessName       String                    @map("business_name")
  displayName        String                    @map("display_name")
  logoUrl            String?                   @map("logo_url")
  description        String?                   @db.Text
  email              String?
  phone              String?
  website            String?
  verificationStatus PartnerVerificationStatus @default(unverified) @map("verification_status")
  rating             Decimal                   @default(0) @db.Decimal(3, 2)
  services           Json                      @default("[]")
  categories         Json                      @default("[]")
  businessHours      Json                      @default("{}") @map("business_hours")
  socialLinks        Json                      @default("{}") @map("social_links")
  certifications     Json                      @default("[]")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("partner_profiles")
}

model PartnerBadgeAssignment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  badgeCode      String   @map("badge_code") @db.VarChar(64)
  assignedBy     String   @map("assigned_by") @db.VarChar(32)
  reason         String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, badgeCode])
  @@index([organizationId])
  @@map("partner_badge_assignments")
}

model OrganizationEntitlement {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  featureKey     String   @map("feature_key") @db.VarChar(64)
  granted        Boolean
  source         String   @default("override") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, featureKey])
  @@index([organizationId])
  @@map("organization_entitlements")
}

// --- Batch 7: Sales OS (Lead quality, CRM, Opportunity, PIN routing, Lead Board) ---

model CustomerConsent {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  leadId      String?   @map("lead_id")
  channel     String    @db.VarChar(16)
  purpose     String    @db.VarChar(32)
  status      String    @default("GRANTED") @db.VarChar(16)
  source      String    @db.VarChar(64)
  capturedAt  DateTime  @default(now()) @map("captured_at")
  withdrawnAt DateTime? @map("withdrawn_at")
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([leadId])
  @@index([channel, purpose])
  @@map("customer_consents")
}

model CrmActivity {
  id             String    @id @default(uuid())
  leadId         String    @map("lead_id")
  opportunityId  String?   @map("opportunity_id")
  dealerId       String    @map("dealer_id")
  organizationId String?   @map("organization_id")
  actorUserId    String    @map("actor_user_id")
  activityType   String    @map("activity_type") @db.VarChar(32)
  subject        String    @db.VarChar(160)
  notes          String?   @db.Text
  scheduledAt    DateTime? @map("scheduled_at")
  completedAt    DateTime? @map("completed_at")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  dealer         Dealer    @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([dealerId, createdAt])
  @@index([leadId, createdAt])
  @@index([opportunityId])
  @@map("crm_activities")
}

model Opportunity {
  id              String    @id @default(uuid())
  leadId          String    @map("lead_id")
  customerUserId  String?   @map("customer_user_id")
  dealerId        String    @map("dealer_id")
  organizationId  String?   @map("organization_id")
  vehicleId       String?   @map("vehicle_id")
  inventoryId     String?   @map("inventory_id")
  status          String    @default("OPEN") @db.VarChar(24)
  quality         String?   @db.VarChar(16)
  estimatedValue  Decimal?  @map("estimated_value") @db.Decimal(12, 2)
  ownerUserId     String    @map("owner_user_id")
  nextFollowUpAt  DateTime? @map("next_follow_up_at")
  lostReason      String?   @map("lost_reason") @db.Text
  wonAt           DateTime? @map("won_at")
  lostAt          DateTime? @map("lost_at")
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  dealer          Dealer    @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner           User      @relation("OpportunityOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  links           OpportunityLink[]
  activities      CrmActivity[]

  @@index([dealerId, status])
  @@index([leadId])
  @@index([ownerUserId])
  @@index([organizationId])
  @@map("opportunities")
}

model OpportunityLink {
  id             String   @id @default(uuid())
  opportunityId  String   @map("opportunity_id")
  objectType     String   @map("object_type") @db.VarChar(24)
  objectId       String   @map("object_id")
  createdAt      DateTime @default(now()) @map("created_at")

  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, objectType, objectId])
  @@index([objectType, objectId])
  @@map("opportunity_links")
}

model PartnerCoverage {
  id             String   @id @default(uuid())
  dealerId       String   @map("dealer_id")
  organizationId String?  @map("organization_id")
  branchId       String?  @map("branch_id")
  domain         String   @db.VarChar(24)
  postalCode     String   @map("postal_code") @db.VarChar(6)
  status         String   @default("ACTIVE") @db.VarChar(16)
  priority       Int      @default(100)
  capacity       Int?
  routingMode    String   @default("STANDARD") @map("routing_mode") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  dealer         Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([dealerId, domain, postalCode])
  @@index([domain, postalCode, status])
  @@index([organizationId])
  @@map("partner_coverages")
}

model LeadAssignment {
  id             String    @id @default(uuid())
  leadId         String    @map("lead_id")
  dealerId       String    @map("dealer_id")
