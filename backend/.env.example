# PostgreSQL (Docker: npm run db:up from repo root)
DATABASE_URL="postgresql://motorcart:strongpassword@localhost:5432/motorcart?schema=public"

# JWT — change in production (min 32 characters)
JWT_SECRET=change-me-jwt-secret-min-32-characters-long
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Redis (Docker: redis://redis:6379)
REDIS_URL=redis://localhost:6379

# Optional — server-side only. Never put this key in frontend/VITE_* vars.
OPENAI_API_KEY=

# Phase 3 organization / partner foundation (default on)
# FEATURE_ORGANIZATION_LAYER=true

# Phase C finance marketplace REST (default on when unset; set false to keep RPC/mock)
# FEATURE_FINANCE_MARKETPLACE=true
# FEATURE_FINANCE_ELIGIBILITY_API=true
# FEATURE_FINANCE_COMPARE_API=true
# FEATURE_FINANCE_SOFT_APPROVAL=true
# FEATURE_FINANCE_DOCUMENTS_API=true
# FEATURE_SALES_OS=true
# FEATURE_LEAD_BOARD=false
# FEATURE_PAID_LEADS=false
# FEATURE_M4_NOTIFICATIONS=true
# FEATURE_M5_UNIFIED_SEARCH=true
# FEATURE_COMMERCIAL_ENGINE=true
# FEATURE_PAYMENT_GATEWAY=false
# FEATURE_COMMUNICATIONS=true
# FEATURE_DIALER=false
# FEATURE_AI_CALLING=false
# COMM_WEBHOOK_SECRET=
# COMMERCIAL_WEBHOOK_SECRET=
# STRICT_DB_QUERY=true
# DEV_WRITE_TABLES=false

# Uploads (local storage; S3-ready path structure)
UPLOAD_DIR=./uploads

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@motorcart.in
MAILER_AUTOCONFIRM=false

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phase B feature flags (default on when unset)
# FEATURE_VEHICLE_SALE_MODE=true
# FEATURE_NEW_CAR_INVENTORY_V2=true
# FEATURE_WISHLIST_DB=true
# FEATURE_UNIFIED_VEHICLE_API=true
# FEATURE_PARTS_COMPATIBILITY=true

# Phase F auction flags (default OFF — do not enable until after db push + F1+)
# FEATURE_AUCTION_V2=false
# FEATURE_AUCTION_CATEGORIES=false
# FEATURE_AUCTION_PROXY_BID=false
# FEATURE_AUCTION_AUTO_BID=false
# FEATURE_AUCTION_WATCHLIST=false
# FEATURE_AUCTION_BID_HISTORY=false
# FEATURE_AUCTION_KYC_GATE=false

# Phase E broker CRM flags (default OFF — schema only until E1+)
# FEATURE_BROKER_CRM=false
# FEATURE_BROKER_CONTACTS=false
# FEATURE_BROKER_LEADS=false
# FEATURE_BROKER_DEALS=false
# FEATURE_BROKER_VEHICLE_ASSIGN=false
# FEATURE_BROKER_TASKS=false
# FEATURE_BROKER_COMMISSIONS=false
# FEATURE_BROKER_WHATSAPP=false
# FEATURE_BROKER_MARKETPLACE_BRIDGE=false

# Phase I community flags (default OFF — I1 APIs return 404 until enabled)
# FEATURE_COMMUNITY_V2=false
# FEATURE_COMMUNITY_PROFILES=false
# FEATURE_COMMUNITY_BUSINESS_PROFILES=false
# FEATURE_COMMUNITY_FEED=false
# FEATURE_COMMUNITY_POSTS=false
# FEATURE_COMMUNITY_FOLLOW=false

# Phase I2 community groups + business pages (default OFF)
# FEATURE_COMMUNITY_GROUPS=false
# FEATURE_COMMUNITY_GROUP_FEED=false
# FEATURE_COMMUNITY_GROUP_MODERATION=false
# FEATURE_COMMUNITY_BUSINESS_PAGES=false

# Phase J Growth CRM (default OFF — /api/growth/* returns 404 until enabled)
# FEATURE_GROWTH_V2=false
# FEATURE_GROWTH_WORKSPACES=false
# FEATURE_GROWTH_ASSETS=false
# FEATURE_GROWTH_POSTERS=false
# FEATURE_GROWTH_WHATSAPP=false
# FEATURE_GROWTH_LEADS=false
# FEATURE_GROWTH_LEAD_PIPELINE=false

# Phase K2 business directory (default OFF)
# FEATURE_BUSINESS_DIRECTORY_V2=false

# Phase K1 directory monetization — requires FEATURE_BUSINESS_DIRECTORY_V2 (default OFF)
# FEATURE_K1_DIRECTORY_MONETIZATION=false

# Phase L1 Growth WhatsApp provider architecture — requires FEATURE_GROWTH_WHATSAPP (default OFF)
# FEATURE_GROWTH_WHATSAPP_PROVIDERS=false

# Phase L2 Growth social scheduler — requires FEATURE_GROWTH_WORKSPACES (default OFF)
# FEATURE_GROWTH_SOCIAL_SCHEDULER=false

# Phase M0 founder / investor dashboard (default OFF)
# FEATURE_M0_FOUNDER_DASHBOARD=false

# Phase M1.0 unified identity context (default OFF)
# FEATURE_M1_UNIFIED_IDENTITY=false

# Phase M2.0 business hub (default OFF)
# FEATURE_M2_UNIFIED_BUSINESS=false

# Phase M3.0 unified lead router (default OFF)
# FEATURE_M3_LEAD_ROUTER=false

# Phase M4.0 unified notification center (default OFF)
# FEATURE_M4_NOTIFICATIONS=false

# Phase M5.0 federated unified search (default OFF)
# FEATURE_M5_UNIFIED_SEARCH=false

# Phase N2.1 billing MVP — mock plans/subscriptions (default OFF)
# FEATURE_BILLING_V2=false

# Phase Catalog 1 — master catalog layer (default OFF; schema + seeds only until Phase 2+)
# FEATURE_CATALOG_LAYER=false
# FEATURE_CATALOG_PUBLIC_API=false
# FEATURE_CATALOG_ADMIN=false

# Phase 5G-1 — catalog master JSON API (licensed new-vehicle feed only; leave URL empty until credentials exist)
# CATALOG_MASTER_SOURCE=json_api
# CATALOG_MASTER_SOURCE_URL=
# CATALOG_MASTER_API_KEY=

# Phase 5E catalog publish storage (required for publish — R2 or S3 only)
# STORAGE_PROVIDER=cloudflare_r2
# STORAGE_BUCKET=motorcart-catalog
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ACCOUNT_ID=
# STORAGE_PUBLIC_BASE_URL=
# STORAGE_REGION=auto
# STORAGE_ENDPOINT=
