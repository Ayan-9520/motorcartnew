# MySQL (XAMPP default: root with no password)
DATABASE_URL="mysql://root:@localhost:3306/motorcart"

# JWT — change in production (min 32 characters)
JWT_SECRET=change-me-jwt-secret-min-32-characters-long
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Uploads (local storage; S3-ready path structure)
UPLOAD_DIR=./uploads

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@motorcart.in
MAILER_AUTOCONFIRM=false

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis (optional)
# REDIS_URL=redis://localhost:6379
