{
  "expo": {
    "name": "Motorcart",
    "slug": "motorcart-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "motorcart",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b141a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.motorcart.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Motorcart may use the camera for vehicle photos and KYC documents.",
        "NSPhotoLibraryUsageDescription": "Motorcart may access photos for vehicle listings and profile."
      }
    },
    "android": {
      "package": "in.motorcart.app",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0b141a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "motorcart.in",
              "pathPrefix": "/"
            },
            {
              "scheme": "motorcart"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Motorcart",
      "shortName": "Motorcart",
      "description": "Motorcart — India's AI-powered automotive OS"
    },
    "plugins": ["expo-secure-store"]
  }
}
