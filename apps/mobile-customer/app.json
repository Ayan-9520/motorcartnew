{
  "expo": {
    "name": "Motorcart",
    "slug": "motorcart-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "motorcart",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b141a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.motorcart.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "in.motorcart.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0b141a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "motorcart.in",
              "pathPrefix": "/app"
            },
            {
              "scheme": "motorcart"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Motorcart",
      "shortName": "Motorcart",
      "description": "Motorcart — India's AI-powered automotive OS. Companion app for buyers, dealers & partners."
    },
    "plugins": ["expo-secure-store"]
  }
}
