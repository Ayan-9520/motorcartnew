# Local Expo → Docker API on :3000
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Demo logins OFF (production default)
EXPO_PUBLIC_SHOW_DEMO_LOGINS=false
EXPO_PUBLIC_SHOW_DEMO=0

# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Physical phone (same Wi‑Fi — use your PC IPv4):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Production / Play Store builds use eas.json → https://motorcart.in
