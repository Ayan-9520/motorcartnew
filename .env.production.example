# Copy to .env.production on your VPS and fill every CHANGE_ME value.
# Deploy: docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml up -d --build

NODE_ENV=production

# --- Database (internal Docker network; localhost-only host bind in prod compose) ---
POSTGRES_DB=motorcart
POSTGRES_USER=motorcart
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password_min_24_chars
POSTGRES_PORT=5432

REDIS_PORT=6379

# --- Backend ---
PORT=3001
DATABASE_URL=postgresql://motorcart:CHANGE_ME_strong_postgres_password_min_24_chars@postgres:5432/motorcart?schema=public
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_characters_long
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_32_chars
REDIS_URL=redis://redis:6379
OPENAI_API_KEY=

# Your live domain (HTTPS after SSL)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com
NGINX_HTTP_PORT=80
NGINX_PORT=80

# Same-origin API (leave empty — nginx proxies /api)
VITE_API_URL=
VITE_SOCKET_URL=
VITE_SITE_URL=https://yourdomain.com

FEATURE_FULL_ECOSYSTEM=true
VITE_FULL_ECOSYSTEM=true
FEATURE_WISHLIST_DB=true
VITE_FEATURE_WISHLIST_DB=true
FEATURE_UNIFIED_VEHICLE_API=true
VITE_FEATURE_UNIFIED_VEHICLE_API=true
FEATURE_M4_NOTIFICATIONS=true
VITE_FEATURE_M4_NOTIFICATIONS=true

# Deploy: real PostgreSQL data only — never seed demo rows on boot
VITE_REAL_DATA_ONLY=true
VITE_ADMIN_DEMO_FALLBACK=false
RUN_DB_SEED=false
STRICT_DB_QUERY=true

# Email — Hostinger SMTP (required for real signup verify + email OTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@motorcart.in
SMTP_PASS=CHANGE_ME
MAIL_FROM="MotorCart <noreply@motorcart.in>"
MAILER_AUTOCONFIRM=false

# SMS OTP (phone login) — Hostinger does not send SMS; use MSG91 or similar
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=MTRCRT
# SMS_TEMPLATE_ID=

# Optional mobile web preview
MOBILE_APP_PORT=8090
MOBILE_EXPO_PUBLIC_API_URL=
MOBILE_SHOW_DEMO=0
